# Copy to backend/.env and fill in real values. Never commit backend/.env.
# The server refuses to start if any of DB_HOST, DB_USER, DB_PASSWORD,
# DB_NAME or JWT_SECRET is missing (see backend/config/validateEnv.js).

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=your_database_name
# Set DB_SSL=true when using cloud providers like Aiven (requires SSL)
DB_SSL=false

# Signs the session cookie. Use at least 32 characters, unique per
# environment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

PORT=5000

# Origin allowed to send credentialed requests. Defaults to the Vite dev server.
CLIENT_ORIGIN=http://localhost:5173

# Set to "production" in deployed environments so the auth cookie is HTTPS-only.
NODE_ENV=development

# --- ImageKit (optional) -----------------------------------------------------
# From https://imagekit.io/dashboard/developer/api-keys
# All three must be set or image uploads stay disabled (the upload endpoint
# answers 503 and the rest of the app works normally).
# IMAGEKIT_PRIVATE_KEY is a secret: it stays on the server and is never sent to
# the browser, which is why uploads are proxied through POST /api/upload/image.
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Folder that uploads land in (per-user subfolders are created underneath).
IMAGEKIT_FOLDER=/calorie-tracker
